---
import { links } from '../config';
---

<section class="pt-32 pb-20 px-6 bg-gradient-to-b from-brand-bg to-white dark:from-brand-dark-surface dark:to-brand-dark-bg transition-colors duration-200">
  <div class="max-w-4xl mx-auto text-center">
    <img src="/logo.svg" alt="10plate" class="w-40 h-40 mx-auto mb-0" />
    <p class="text-5xl md:text-6xl font-extrabold text-brand-text dark:text-brand-dark-text mb-12 -mt-2">10Plate</p>

    <h1 class="text-5xl md:text-6xl font-extrabold text-brand-text dark:text-brand-dark-text leading-tight mb-6">
      Plan together.<br />
      <span class="text-brand-primary dark:text-brand-dark-primary">Build together.</span>
    </h1>

    <p class="text-xl text-brand-text-muted dark:text-brand-dark-text-muted max-w-2xl mx-auto mb-10 leading-relaxed">
      10plate gives your team an infinite canvas to brainstorm ideas, organise them into groups,
      and present a clear plan — all in real time.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={links.register}
        class="w-full sm:w-auto text-base font-semibold bg-brand-primary text-white px-8 py-3.5 rounded-xl hover:bg-brand-primary-dark transition-colors shadow-lg shadow-brand-primary/25"
      >
        Start for free
      </a>
      <a
        href="#how-it-works"
        class="w-full sm:w-auto text-base font-semibold text-brand-text-muted dark:text-brand-dark-text-muted px-8 py-3.5 rounded-xl border border-brand-border dark:border-brand-dark-border hover:border-brand-primary/40 dark:hover:border-brand-dark-primary/40 hover:bg-brand-surface dark:hover:bg-brand-dark-surface-hi transition-colors"
      >
        See how it works
      </a>
    </div>

    <p class="mt-4 text-sm text-brand-text-muted/60 dark:text-brand-dark-text-muted/60">No credit card required</p>
  </div>

  <!-- Animated session mockup -->
  <div class="max-w-5xl mx-auto mt-16 relative">
    <div class="rounded-2xl border border-brand-border dark:border-brand-dark-border shadow-2xl overflow-hidden transition-colors duration-200">

      <!-- Browser chrome -->
      <div class="bg-white dark:bg-brand-dark-surface-hi border-b border-brand-border dark:border-brand-dark-border-sub px-4 py-3 flex items-center gap-2 transition-colors duration-200">
        <div class="w-3 h-3 rounded-full bg-red-400"></div>
        <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
        <div class="w-3 h-3 rounded-full bg-green-400"></div>
        <div class="flex-1 mx-4 bg-brand-surface dark:bg-brand-dark-bg rounded-md h-6 flex items-center px-3">
          <span class="text-xs text-brand-text-muted dark:text-brand-dark-text-muted">app.10plate.io/groups/product-team/brainstorms/q3-sprint</span>
        </div>
      </div>

      <!-- Simulated app (460px tall) -->
      <div id="project-sim" style="position:relative;height:460px;overflow:hidden;background:var(--sim-bg-outer);">

        <!-- ── App bar (56px) ──────────────────────────────────────── -->
        <div style="position:absolute;top:0;left:0;right:0;height:56px;background:var(--sim-surface);border-bottom:1px solid var(--sim-outline);display:flex;align-items:center;justify-content:space-between;padding:0 8px 0 4px;z-index:20;box-shadow:0 1px 4px var(--sim-shadow-a);">
          <div style="display:flex;align-items:center;gap:4px;">
            <div style="width:40px;height:40px;display:flex;align-items:center;justify-content:center;border-radius:50%;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--sim-on-surface-var)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </div>
            <div>
              <div style="font-size:14px;font-weight:600;color:var(--sim-on-surface);line-height:1.25;">Q3 Planning Sprint</div>
              <div style="font-size:11px;color:var(--sim-on-surface-var);line-height:1.3;">Sarah presenting</div>
            </div>
          </div>
          <div style="display:flex;align-items:center;">
            <div style="width:40px;height:40px;display:flex;align-items:center;justify-content:center;border-radius:50%;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--sim-on-surface-var)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><circle cx="12" cy="20" r="1" fill="var(--sim-on-surface-var)" stroke="none"/></svg>
            </div>
            <div style="width:40px;height:40px;display:flex;align-items:center;justify-content:center;border-radius:50%;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--sim-on-surface-var)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <div style="width:40px;height:40px;display:flex;align-items:center;justify-content:center;border-radius:50%;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--sim-on-surface-var)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><circle cx="12" cy="8" r="0.5" fill="var(--sim-on-surface-var)"/></svg>
            </div>
          </div>
        </div>

        <!-- ── Slide tab bar (40px at top:56px) ──────────────────── -->
        <div id="sim-tabbar" style="position:absolute;top:56px;left:0;right:0;height:40px;background:var(--sim-surface);border-bottom:1px solid var(--sim-outline);display:flex;align-items:center;padding:0 6px;z-index:20;gap:1px;overflow:hidden;">

          <div id="sim-prev" class="sim-nav-arrow" style="opacity:0.3;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--sim-on-surface)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </div>

          <!-- Tab 0: Problem -->
          <div id="sim-tab-0" class="sim-tab sim-tab-active" data-idx="0">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18h6M10.5 21h3"/><path d="M12 2a7 7 0 0 1 7 7c0 2.38-1.19 4.47-3 5.74V17a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1v-2.26C6.19 13.47 5 11.38 5 9a7 7 0 0 1 7-7z"/>
            </svg>
            <span>Problem</span>
          </div>

          <svg class="sim-tab-sep" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--sim-outline)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>

          <!-- Tab 1: Brainstorm -->
          <div id="sim-tab-1" class="sim-tab" data-idx="1">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="13" y1="17" x2="8" y2="17"/>
            </svg>
            <span>Brainstorm</span>
          </div>

          <svg class="sim-tab-sep" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--sim-outline)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>

          <!-- Tab 2: Group -->
          <div id="sim-tab-2" class="sim-tab" data-idx="2">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"/><line x1="12" y1="2" x2="12" y2="9"/><line x1="12" y1="15" x2="12" y2="22"/><line x1="2" y1="12" x2="9" y2="12"/><line x1="15" y1="12" x2="22" y2="12"/>
            </svg>
            <span>Group</span>
          </div>

          <svg class="sim-tab-sep" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--sim-outline)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>

          <!-- Tab 3: Vote -->
          <div id="sim-tab-3" class="sim-tab" data-idx="3">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
            </svg>
            <span>Vote</span>
          </div>

          <svg class="sim-tab-sep" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--sim-outline)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>

          <!-- Tab 4: Prioritise -->
          <div id="sim-tab-4" class="sim-tab" data-idx="4">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>
            </svg>
            <span>Prioritise</span>
          </div>

          <div style="flex:1;min-width:4px;"></div>
          <span id="sim-counter" style="font-size:12px;color:var(--sim-on-surface-var);white-space:nowrap;flex-shrink:0;">1 / 5</span>
          <div style="width:3px;flex-shrink:0;"></div>

          <div id="sim-next" class="sim-nav-arrow sim-nav-arrow-active">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--sim-on-surface)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </div>
        </div>

        <!-- ── Canvas (top:96 = 56+40, bottom:34) ────────────────── -->
        <div id="sim-canvas" style="position:absolute;top:96px;bottom:34px;left:0;right:0;">

          <!-- Problem slide card (shown on slide 0) -->
          <div id="sim-problem-card" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;z-index:8;pointer-events:none;">
            <div style="background:var(--sim-surface);border-radius:16px;padding:24px 28px;max-width:420px;width:100%;box-shadow:0 4px 20px var(--sim-shadow-b),0 1px 6px var(--sim-shadow-c);">
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
                <div style="width:36px;height:36px;border-radius:50%;background:var(--sim-primary-container);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--sim-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10.5 21h3"/><path d="M12 2a7 7 0 0 1 7 7c0 2.38-1.19 4.47-3 5.74V17a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1v-2.26C6.19 13.47 5 11.38 5 9a7 7 0 0 1 7-7z"/></svg>
                </div>
                <span style="font-size:10px;font-weight:700;color:var(--sim-on-surface-var);text-transform:uppercase;letter-spacing:0.08em;">Problem Statement</span>
              </div>
              <p style="font-size:16px;font-weight:600;color:var(--sim-on-surface);line-height:1.5;margin:0 0 10px;">What are our Q3 priorities?</p>
              <p style="font-size:13px;color:var(--sim-on-surface-var);line-height:1.6;margin:0;">Define the top initiatives that will drive product growth and improve user experience this quarter.</p>
            </div>
          </div>

          <!-- Prioritise matrix (shown on slide 4) -->
          <div id="sim-matrix" style="position:absolute;inset:0;opacity:0;z-index:3;pointer-events:none;display:flex;flex-direction:column;padding:12px 12px 22px 30px;">
            <!-- Y-axis label -->
            <div style="position:absolute;left:2px;top:50%;transform:translateY(-50%) rotate(-90deg);font-size:9px;font-weight:600;color:var(--sim-on-surface-var);white-space:nowrap;letter-spacing:0.06em;">VALUE ↑</div>
            <!-- 2×2 grid -->
            <div style="flex:1;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;border:1px solid var(--sim-outline);border-radius:8px;overflow:hidden;">
              <div style="border-right:1px solid var(--sim-outline);border-bottom:1px solid var(--sim-outline);background:rgba(165,214,167,0.14);position:relative;padding:6px 8px;">
                <span style="font-size:10px;font-weight:700;color:#4CAF50;">Do First</span>
              </div>
              <div style="border-bottom:1px solid var(--sim-outline);background:rgba(144,202,249,0.14);position:relative;padding:6px 8px;">
                <span style="font-size:10px;font-weight:700;color:#2196F3;">Plan</span>
              </div>
              <div style="border-right:1px solid var(--sim-outline);background:rgba(255,204,128,0.14);position:relative;padding:6px 8px;">
                <span style="font-size:10px;font-weight:700;color:#FF9800;">Later</span>
              </div>
              <div style="background:rgba(244,143,177,0.14);position:relative;padding:6px 8px;">
                <span style="font-size:10px;font-weight:700;color:#E91E63;">Avoid</span>
              </div>
            </div>
            <!-- X-axis label -->
            <div style="text-align:right;padding:3px 0 0;font-size:9px;font-weight:600;color:var(--sim-on-surface-var);letter-spacing:0.06em;">COST →</div>
          </div>

          <!-- Notes and group rect divs are injected by JS -->
        </div>

        <!-- ── Status bar (34px) ──────────────────────────────────── -->
        <div style="position:absolute;bottom:0;left:0;right:0;height:34px;background:var(--sim-statusbar-bg);border-top:1px solid var(--sim-outline);display:flex;align-items:center;padding:0 16px;gap:8px;z-index:20;">
          <div style="display:flex;">
            <div style="width:22px;height:22px;border-radius:50%;background:#60A5FA;border:2px solid var(--sim-surface);display:flex;align-items:center;justify-content:center;color:white;font-size:9px;font-weight:800;position:relative;z-index:3;margin-right:-7px;">S</div>
            <div style="width:22px;height:22px;border-radius:50%;background:#34D399;border:2px solid var(--sim-surface);display:flex;align-items:center;justify-content:center;color:white;font-size:9px;font-weight:800;position:relative;z-index:2;margin-right:-7px;">J</div>
            <div style="width:22px;height:22px;border-radius:50%;background:#A78BFA;border:2px solid var(--sim-surface);display:flex;align-items:center;justify-content:center;color:white;font-size:9px;font-weight:800;position:relative;z-index:1;">M</div>
          </div>
          <span style="font-size:11px;color:var(--sim-on-surface-var);margin-left:8px;">3 collaborating</span>
          <div style="margin-left:auto;display:flex;align-items:center;gap:5px;">
            <div class="sim-live-dot"></div>
            <span style="font-size:11px;color:var(--sim-on-surface-var);">Live</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- ── Scoped styles (applied to static HTML which gets Astro's scope attr) ── -->
<style>
  @keyframes simLivePulse {
    0%, 100% { opacity:1; transform:scale(1); }
    50%       { opacity:0.5; transform:scale(0.82); }
  }
  .sim-live-dot {
    width:7px; height:7px; border-radius:50%;
    background:#22C55E;
    animation:simLivePulse 2s ease-in-out infinite;
  }
  .sim-tab {
    display:flex; align-items:center; gap:5px;
    padding:4px 8px; border-radius:4px;
    background:transparent; cursor:pointer; flex-shrink:0;
    transition:background 0.15s ease, color 0.15s ease;
    color:var(--sim-on-surface-var);
  }
  .sim-tab span { font-size:12px; font-weight:400; color:inherit; }
  .sim-tab svg  { flex-shrink:0; }
  .sim-tab-active { background:var(--sim-primary-container); color:var(--sim-primary); }
  .sim-tab-active span { font-weight:600; }
  .sim-tab-sep  { flex-shrink:0; }
  .sim-nav-arrow {
    padding:2px 6px; border-radius:4px;
    display:flex; align-items:center; flex-shrink:0;
    background:transparent;
  }
  .sim-nav-arrow-active { background:var(--sim-surface-high); }

  /* Hide tab labels on narrow containers */
  @media (max-width:700px) {
    .sim-tab span { display:none; }
    .sim-tab-sep  { display:none; }
  }
</style>

<!-- ── Global styles for CSS vars + JS-generated elements ── -->
<style is:global>
  :root {
    --sim-bg-outer:           #EEF0F4;
    --sim-surface:            #FFFFFF;
    --sim-canvas-bg:          #DDE1E8;
    --sim-canvas-dot:         #A8B2C0;
    --sim-outline:            #CAC4D0;
    --sim-on-surface:         #1C1B1F;
    --sim-on-surface-var:     #79747E;
    --sim-primary:            #4A90E2;
    --sim-primary-container:  #DBEEFF;
    --sim-surface-high:       #E6E2E6;
    --sim-statusbar-bg:       rgba(255,255,255,0.92);
    --sim-shadow-a:           rgba(0,0,0,0.06);
    --sim-shadow-b:           rgba(0,0,0,0.14);
    --sim-shadow-c:           rgba(0,0,0,0.08);
  }
  html.dark {
    --sim-bg-outer:           #1C1B1F;
    --sim-surface:            #2B2930;
    --sim-canvas-bg:          #1A1921;
    --sim-canvas-dot:         #38353F;
    --sim-outline:            #49454F;
    --sim-on-surface:         #E6E1E5;
    --sim-on-surface-var:     #CAC4D0;
    --sim-primary:            #90CAF9;
    --sim-primary-container:  #0D3461;
    --sim-surface-high:       #36343B;
    --sim-statusbar-bg:       rgba(43,41,48,0.92);
    --sim-shadow-a:           rgba(0,0,0,0.25);
    --sim-shadow-b:           rgba(0,0,0,0.45);
    --sim-shadow-c:           rgba(0,0,0,0.3);
  }

  /* Canvas dot grid — uses CSS vars so dark/light mode works */
  #sim-canvas {
    background-color: var(--sim-canvas-bg);
    background-image: radial-gradient(circle, var(--sim-canvas-dot) 1px, transparent 1px);
    background-size: 20px 20px;
  }

  /* Group background rects (JS-generated) */
  .sim-grp-rect {
    position: absolute;
    border-radius: 12px;
    z-index: 4;
    opacity: 0;
    pointer-events: none;
    top: 8%;
    height: 80%;
    width: 24%;
  }

  /* Note cards (JS-generated) — matches Flutter: borderRadius:3, elevation:6 */
  .sim-note {
    position: absolute;
    width: 148px;
    border-radius: 3px;
    padding: 12px 22px 10px 12px;
    box-shadow: 0 3px 14px rgba(0,0,0,0.18), 0 1px 4px rgba(0,0,0,0.1);
    opacity: 0;
    z-index: 10;
    pointer-events: none;
    box-sizing: border-box;
  }
  .sim-note-text {
    font-size: 13px;
    font-weight: 400;
    color: rgba(0,0,0,0.87);
    line-height: 1.45;
    margin: 0 0 8px;
  }
  .sim-note-author {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .sim-note-author-avatar {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 8px;
    font-weight: 800;
    flex-shrink: 0;
  }
  .sim-note-author-name {
    font-size: 11px;
    color: rgba(0,0,0,0.38);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sim-note-votes {
    opacity: 0;
    margin-top: 6px;
    display: flex;
    align-items: center;
    gap: 1px;
  }
</style>

<script>
  (function () {
    // ── Note data ─────────────────────────────────────────────────────────────
    // Colors match Flutter's _noteColors: #FFF176, #A5D6A7, #F48FB1, #90CAF9, #FFCC80, #CE93D8
    // b = brainstorm positions, g = group positions, p = prioritise positions
    const NOTES = [
      { id:'n0', text:'User onboarding redesign',  color:'#FFF176', author:'S', authorBg:'#60A5FA', name:'Sarah',
        b:{ l:'3%',  t:'7%',  r:-2   }, g:{ l:'3%',  t:'13%', r:-0.5 }, p:{ l:'56%', t:'11%', r:0 }, votes:3 },
      { id:'n1', text:'API rate limiting strategy', color:'#90CAF9', author:'J', authorBg:'#34D399', name:'James',
        b:{ l:'37%', t:'5%',  r:1.5  }, g:{ l:'37%', t:'13%', r:0.5  }, p:{ l:'9%',  t:'11%', r:0 }, votes:5 },
      { id:'n2', text:'Mobile push notifications',  color:'#A5D6A7', author:'M', authorBg:'#A78BFA', name:'Maya',
        b:{ l:'68%', t:'9%',  r:-1   }, g:{ l:'68%', t:'13%', r:-0.5 }, p:{ l:'22%', t:'63%', r:0 }, votes:2 },
      { id:'n3', text:'Improve search relevance',   color:'#FFCC80', author:'S', authorBg:'#60A5FA', name:'Sarah',
        b:{ l:'5%',  t:'56%', r:2    }, g:{ l:'3%',  t:'53%', r:0.5  }, p:{ l:'9%',  t:'31%', r:0 }, votes:3 },
      { id:'n4', text:'Analytics dashboard v2',     color:'#CE93D8', author:'J', authorBg:'#34D399', name:'James',
        b:{ l:'40%', t:'60%', r:-1.5 }, g:{ l:'37%', t:'53%', r:-0.5 }, p:{ l:'58%', t:'54%', r:0 }, votes:5 },
      { id:'n5', text:'SSO enterprise auth',        color:'#F48FB1', author:'M', authorBg:'#A78BFA', name:'Maya',
        b:{ l:'67%', t:'57%', r:1    }, g:{ l:'68%', t:'53%', r:0    }, p:{ l:'22%', t:'46%', r:0 }, votes:2 },
    ];

    // Group rects — colors from Flutter's _groupPalette (fill=16% alpha, border=full)
    const GROUPS = [
      { id:'grp0', left:'1%',  fill:'rgba(165,214,167,0.16)', border:'#66BB6A' },
      { id:'grp1', left:'35%', fill:'rgba(144,202,249,0.16)', border:'#42A5F5' },
      { id:'grp2', left:'66%', fill:'rgba(255,204,128,0.16)', border:'#FFA726' },
    ];

    const N_SLIDES    = 5;
    const COUNTERS    = ['1 / 5','2 / 5','3 / 5','4 / 5','5 / 5'];

    // Timing (ms from cycle start)
    const T_NOTE_START  = 2700;   // notes pop in (brainstorm switch at 2500)
    const T_BRAINSTORM  = 2500;   // switch to brainstorm tab
    const T_NOTE_STEP   = 720;    // between note pops
    const T_GROUP       = 8100;   // switch to group
    const T_VOTE        = 12100;  // switch to vote
    const T_PRIORITISE  = 15700;  // switch to prioritise
    const T_CYCLE       = 20200;  // restart

    // ── DOM setup ─────────────────────────────────────────────────────────────
    function setup() {
      const canvas = document.getElementById('sim-canvas');
      if (!canvas) return;

      // Group background rects
      GROUPS.forEach(g => {
        const el = document.createElement('div');
        el.id = g.id;
        el.className = 'sim-grp-rect';
        el.style.cssText += `left:${g.left};background:${g.fill};border:1.5px solid ${g.border};`;
        canvas.appendChild(el);
      });

      // Note cards
      NOTES.forEach(n => {
        const el = document.createElement('div');
        el.id = n.id;
        el.className = 'sim-note';
        el.style.background = n.color;
        el.style.left = n.b.l;
        el.style.top  = n.b.t;
        el.style.transform = `rotate(${n.b.r}deg) scale(1)`;

        const filled = '★'.repeat(n.votes);
        const empty  = '★'.repeat(5 - n.votes);
        el.innerHTML = `
          <p class="sim-note-text">${n.text}</p>
          <div class="sim-note-author">
            <div class="sim-note-author-avatar" style="background:${n.authorBg};">${n.author}</div>
            <span class="sim-note-author-name">${n.name}</span>
          </div>
          <div id="${n.id}-v" class="sim-note-votes">
            <span style="font-size:13px;color:#F59E0B;line-height:1;">${filled}</span>
            <span style="font-size:13px;color:rgba(0,0,0,0.15);line-height:1;">${empty}</span>
            <span style="font-size:10px;color:rgba(0,0,0,0.38);margin-left:4px;">${n.votes}</span>
          </div>
        `;
        canvas.appendChild(el);
      });
    }

    // ── Tab bar ───────────────────────────────────────────────────────────────
    function setSlide(idx) {
      for (let i = 0; i < N_SLIDES; i++) {
        const tab = document.getElementById(`sim-tab-${i}`);
        if (tab) tab.classList.toggle('sim-tab-active', i === idx);
      }
      const counter = document.getElementById('sim-counter');
      if (counter) counter.textContent = COUNTERS[idx];

      const prev = document.getElementById('sim-prev');
      const next = document.getElementById('sim-next');
      if (prev) {
        prev.style.opacity = idx === 0 ? '0.3' : '1';
        prev.classList.toggle('sim-nav-arrow-active', idx > 0);
      }
      if (next) {
        next.style.opacity = idx === N_SLIDES - 1 ? '0.3' : '1';
        next.classList.toggle('sim-nav-arrow-active', idx < N_SLIDES - 1);
      }
    }

    // ── Phase transitions ─────────────────────────────────────────────────────
    function toProblemPhase() {
      setSlide(0);
      const card = document.getElementById('sim-problem-card');
      if (card) {
        card.style.transition = 'opacity 0.5s ease';
        card.style.opacity = '1';
      }
    }

    function toBrainstormPhase() {
      setSlide(1);
      const card = document.getElementById('sim-problem-card');
      if (card) {
        card.style.transition = 'opacity 0.4s ease';
        card.style.opacity = '0';
      }
    }

    function popNote(n) {
      const el = document.getElementById(n.id);
      if (!el) return;
      el.style.transition = 'none';
      el.style.opacity = '0';
      el.style.transform = `rotate(${n.b.r}deg) scale(0.4)`;
      requestAnimationFrame(() => requestAnimationFrame(() => {
        el.style.transition = 'opacity 0.2s ease, transform 0.38s cubic-bezier(0.34,1.56,0.64,1)';
        el.style.opacity = '1';
        el.style.transform = `rotate(${n.b.r}deg) scale(1)`;
      }));
    }

    function toGroupPhase() {
      setSlide(2);
      NOTES.forEach(n => {
        const el = document.getElementById(n.id);
        if (!el) return;
        el.style.transition = 'left 0.9s cubic-bezier(0.4,0,0.2,1), top 0.9s cubic-bezier(0.4,0,0.2,1), transform 0.5s ease';
        el.style.left      = n.g.l;
        el.style.top       = n.g.t;
        el.style.transform = `rotate(${n.g.r}deg) scale(1)`;
      });
      setTimeout(() => {
        GROUPS.forEach(g => {
          const el = document.getElementById(g.id);
          if (el) { el.style.transition = 'opacity 0.55s ease'; el.style.opacity = '1'; }
        });
      }, 880);
    }

    function toVotePhase() {
      setSlide(3);
      NOTES.forEach((n, i) => {
        setTimeout(() => {
          const v = document.getElementById(`${n.id}-v`);
          if (v) { v.style.transition = 'opacity 0.4s ease'; v.style.opacity = '1'; }
        }, 250 + i * 210);
      });
    }

    function toPrioritisePhase() {
      setSlide(4);
      // Fade out group rects
      GROUPS.forEach(g => {
        const el = document.getElementById(g.id);
        if (el) { el.style.transition = 'opacity 0.4s ease'; el.style.opacity = '0'; }
      });
      // Move notes to matrix positions (no rotation in structured view)
      NOTES.forEach(n => {
        const el = document.getElementById(n.id);
        if (!el) return;
        el.style.transition = 'left 0.95s cubic-bezier(0.4,0,0.2,1), top 0.95s cubic-bezier(0.4,0,0.2,1), transform 0.5s ease';
        el.style.left      = n.p.l;
        el.style.top       = n.p.t;
        el.style.transform = 'rotate(0deg) scale(1)';
      });
      // Fade in matrix after notes start moving
      setTimeout(() => {
        const matrix = document.getElementById('sim-matrix');
        if (matrix) { matrix.style.transition = 'opacity 0.6s ease'; matrix.style.opacity = '1'; }
      }, 350);
    }

    // ── Reset ─────────────────────────────────────────────────────────────────
    function reset() {
      // Notes back to brainstorm positions, hidden
      NOTES.forEach(n => {
        const el = document.getElementById(n.id);
        if (!el) return;
        el.style.transition = 'none';
        el.style.opacity    = '0';
        el.style.left       = n.b.l;
        el.style.top        = n.b.t;
        el.style.transform  = `rotate(${n.b.r}deg) scale(1)`;
        const v = document.getElementById(`${n.id}-v`);
        if (v) { v.style.transition = 'none'; v.style.opacity = '0'; }
      });
      // Group rects hidden
      GROUPS.forEach(g => {
        const el = document.getElementById(g.id);
        if (el) { el.style.transition = 'none'; el.style.opacity = '0'; }
      });
      // Problem card hidden
      const card = document.getElementById('sim-problem-card');
      if (card) { card.style.transition = 'none'; card.style.opacity = '0'; }
      // Matrix hidden
      const matrix = document.getElementById('sim-matrix');
      if (matrix) { matrix.style.transition = 'none'; matrix.style.opacity = '0'; }
      // Reset tabs
      setSlide(0);
    }

    // ── Cycle ─────────────────────────────────────────────────────────────────
    function runCycle() {
      reset();
      setTimeout(() => {
        toProblemPhase();
        setTimeout(toBrainstormPhase, T_BRAINSTORM);
        NOTES.forEach((n, i) => setTimeout(() => popNote(n), T_NOTE_START + i * T_NOTE_STEP));
        setTimeout(toGroupPhase,    T_GROUP);
        setTimeout(toVotePhase,     T_VOTE);
        setTimeout(toPrioritisePhase, T_PRIORITISE);
      }, 80);
      setTimeout(runCycle, T_CYCLE + 100);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => { setup(); runCycle(); });
    } else {
      setup();
      runCycle();
    }
  })();
</script>
